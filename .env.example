# Telegram bot tokeni (@BotFather dan oling) — MAJBURIY
TELEGRAM_BOT_TOKEN=9240375112:AAEDQQckicxzaF720vFTqqdDBuuu9gvg-zU

# Ma'lumotlar bazasi. Lokal: SQLite. Deployment: PostgreSQL, masalan
# postgresql://foydalanuvchi:parol@host:5432/baza_nomi
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tashqi API so'rovlari uchun timeout (soniya)
HTTP_TIMEOUT=10

# Ixtiyoriy: MyMemory kunlik tarjima limitini oshirish uchun email
MYMEMORY_EMAIL=

# Webhook rejimi (hostingda). Bo'sh bo'lsa — polling ishlaydi.
# Masalan: https://mening-botim.example.com
WEBHOOK_URL=
# Ixtiyoriy, lekin tavsiya etiladi: tasodifiy uzun matn (A-Z, a-z, 0-9, _ va -)
WEBHOOK_SECRET=
# Hosting beradigan port (odatda avtomatik)
PORT=8080
